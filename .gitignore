# ---- OS / IDE / 编辑器 --------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# ---- Python (统计验证脚本) ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg
venv/
.venv/
env/
ENV/
.mplcache/
.mplconfig/

# ---- Node.js (本地运行自检时可能生成) ------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---- 临时 / 调试 / 本地输出（不上传 GitHub）-----------------------------
*.log
qin_ops_logs/
qin_ops_log_*/
_test_fragments/
_fragments/
_output/
_output_*/
_debug/
*.local.*
local_*
private_*
secret_*
*.secret
*.local
.env
.env.*
!.env.example

# ---- 本地截图 / 调试输出 ------------------------------------------------
debug_*.png
debug_*.jpg
debug_*.html
debug_*.json
dump_*.json
export_*.json
evidence_*.json
*.export.*

# ---- 浏览器下载/本地扩展产物 --------------------------------------------
QinAvalanche_Guard_互动演示_*.html
QinAvalanche_*_副本*.html
QinAvalanche_*_copy*.html
~$*.docx
$~*.*
*.bak
*.backup
*.old
*.orig

# ---- 压缩/打包/发布中间产物 ---------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ---- 本地证书 / 签名 / 密钥（绝对不允许上传）----------------------------
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.gpg
*.asc
*.sig

# ---- Windows 快捷方式和缩略 ---------------------------------------------
*.lnk
AppData/
Local/Temp/
*.tmp
*.temp

# ---- 可选：用户级本地私有改动（若有本地定制但不愿上传）--------------------
# LOCAL_PRIVATE_*
# deploy_local.bat
# .private.md
